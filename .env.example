# ---- Site (baked in at build time; NEXT_PUBLIC_* values are public) ----
# Canonical origin. Used for metadataBase, the sitemap, robots, OG URLs and COPY LINK.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Discord application id. Unset = /add shows the setup page and the hero CTA becomes the demo.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
# Community invite and repository links shown in the header / footer.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/FhWDZQn9Gy
NEXT_PUBLIC_GITHUB_URL=https://github.com/EeyoreNN/War-dogs
# Contact for the legal pages. Empty = "reach us on the community Discord".
NEXT_PUBLIC_CONTACT_EMAIL=
# WebSocket relay (ws:// or wss://). Unset = LOCAL mode (same-browser sync only).
NEXT_PUBLIC_RELAY_URL=

# ---- Relay (server/relay.ts; runtime, not baked) ----
RELAY_PORT=8787
# Comma-separated origins allowed to connect: the site origin plus
# https://<client id>.discordsays.com when the Discord Activity is enabled. "*" for local dev.
RELAY_ALLOWED_ORIGINS=http://localhost:3000
# Rooms kept in memory before new ones are refused, and how long an idle room lives.
RELAY_MAX_ROOMS=2000
RELAY_IDLE_HOURS=6
